{
  "expo": {
    "name": "UniBus",
    "slug": "unibus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "inc.fastsolucion.unibus",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O UniBus usa sua localização para mostrar paradas e ônibus próximos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020A08",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "inc.fastsolucion.unibus"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020A08",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "scheme": "unibus",
    "backgroundColor": "#020A08",
    "experiments": {
      "typedRoutes": true
    }
  }
}
